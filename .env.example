# App
APP_ENV=development
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# DB
DATABASE_URL=postgresql+psycopg://studygraph:studygraph@db:5432/studygraph
POSTGRES_USER=studygraph
POSTGRES_PASSWORD=studygraph         # dev default; set a strong secret on the VM
POSTGRES_DB=studygraph

# LLM / VLM (NVIDIA NIM). Model IDs are set from the human's model list (ADR-0005).
LLM_PROVIDER=mock                       # nim | mock
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=                            # .env.local and VM environment only; NEVER commit
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
VISION_MODEL=meta/muse-glimmer-30b
VERIFIER_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=meta/muse-glimmer-30b       # glm-5.3 unresponsive in smoke; see ADR-0005
LLM_RPM=                                # requests per minute cap (set from known limits)
LLM_CONCURRENCY=2
LLM_CACHE_DIR=./.cache/llm

# Ingestion
ASR_BACKEND=mock                        # whisper | mock
ASR_MODEL_SIZE=small
EMBED_BACKEND=hash                      # nim | local | hash (nim when key available, ADR-0005)
EMBED_MODEL=nvidia/nemotron-3-embed-1b
MAX_UPLOAD_MB=200

# Grounding / learner / assessment (tunable constants)
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_CONFIDENCE=               # set from eval baseline
QUESTION_DUP_THRESHOLD=0.88
BKT_P_LEARN=0.15
PROPAGATION_ALPHA0=0.4
EXPLORATION_RATE=0.2

# Security
STUDENT_COOKIE_SECRET=changeme
RATE_LIMIT_CHAT_PER_HOUR=60
RATE_LIMIT_GENERATE_PER_HOUR=20
